<?xml version="1.0"?>
<!-- Unraid Docker template for drocsid.
     Install: save as /boot/config/plugins/dockerMan/templates-user/my-drocsid.xml,
     then Docker → Add Container → Template: drocsid → Apply.
     Settings (Discord/Plex IDs and tokens) are read from the .env file named in Extra Parameters. -->
<Container version="2">
  <Name>drocsid</Name>
  <Repository>ghcr.io/vtdrocsid/drocsid:latest</Repository>
  <Registry>https://github.com/vtdrocsid/drocsid/pkgs/container/drocsid</Registry>
  <Network>proxynet</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Project>https://github.com/vtdrocsid/drocsid</Project>
  <Overview>drocsid flips movie night right-side up. Stream your Plex library into a Discord voice channel, synced to the frame for the whole crew. Friends can browse and hit play without ever touching your Plex server, and you run it all from a self-hosted web panel.</Overview>
  <Category>MediaServer:Video</Category>
  <WebUI>https://discordtv.plunkett.cloud/admin</WebUI>
  <ExtraParams>--env-file /mnt/user/appdata/drocsid-src/.env --restart unless-stopped</ExtraParams>
  <Config Name="App data" Target="/data" Default="/mnt/user/appdata/drocsid" Mode="rw" Type="Path" Display="always" Required="true" Description="Settings, play history, lineup and watch progress">/mnt/user/appdata/drocsid</Config>
</Container>
