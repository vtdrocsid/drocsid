# Optional, and only for importing an install from before the setup wizard (read once at first start).
# New installs don't need this file: everything is set up in the wizard at https://<your address>/setup/.

# Public HTTPS address of this container (must match the Activity URL mapping and the OAuth redirect)
PUBLIC_URL=https://example.domain.com

# Discord Developer Portal → your application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Your Discord user ID (comma-separate for more). Owners are always admins.
OWNER_USER_IDS=

# Plex (LAN address the container can reach) and a Plex token for the server owner account
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=
